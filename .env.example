# Variables de Entorno Obligatorias para Render y Desarrollo
PORT=3000
NODE_ENV=development
JWT_SECRET="kuota_super_secret_jwt_key_production_2026"
FRONTEND_URL="http://localhost:5173"

# Base de datos PostgreSQL (Render Managed PostgreSQL o Neon.tech)
# Si en desarrollo local no tienes un servidor PostgreSQL en el puerto 5432,
# el sistema inicia automáticamente un motor PostgreSQL embebido persistente (PGlite) en ./.pgdata
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kuota?schema=public"
